<?xml version="1.0" encoding="utf-8"?>
<ViewAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_animator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/user_lottie"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent=".5"
            app:lottie_autoPlay="true"
            app:lottie_cacheComposition="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/lottie_wifi" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fragment_user_obtaining"
            android:textAppearance="?textAppearanceHeadlineSmall"
            android:textColor="?colorSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/user_lottie" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/material_margin"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:strokeColor="?colorSecondary"
                app:strokeWidth="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/material_margin"
                    android:paddingBottom="@dimen/material_margin">

                    <ImageView
                        android:id="@+id/type_image"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="@dimen/material_margin"
                        android:src="@drawable/ic_user"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent=".1"
                        app:tint="?colorSecondary" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/type_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/material_margin"
                        android:layout_marginEnd="@dimen/material_margin"
                        android:textStyle="bold"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintStart_toEndOf="@id/type_image"
                        app:layout_constraintTop_toTopOf="@id/type_image" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/uuid_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/material_margin"
                        android:layout_marginTop="@dimen/material_margin_micro"
                        android:layout_marginEnd="@dimen/material_margin"
                        android:textAppearance="?textAppearanceBodySmall"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintStart_toEndOf="@id/type_image"
                        app:layout_constraintTop_toBottomOf="@id/type_text" />

                    <com.google.android.material.divider.MaterialDivider
                        android:id="@+id/divider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/material_margin_mini"
                        android:layout_marginBottom="@dimen/material_margin_mini"
                        app:layout_constraintTop_toBottomOf="@id/uuid_text" />

                    <ImageView
                        android:id="@+id/verified_image"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="@dimen/material_margin"
                        android:layout_marginTop="@dimen/material_margin_mini"
                        android:src="@drawable/ic_verified"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/divider"
                        app:layout_constraintWidth_percent=".1"
                        app:tint="?colorSecondary" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/verified_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/material_margin"
                        android:layout_marginEnd="@dimen/material_margin"
                        android:text="@string/fragment_user_verified"
                        android:textStyle="bold"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintStart_toEndOf="@id/verified_image"
                        app:layout_constraintTop_toTopOf="@id/verified_image" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/created_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/material_margin"
                        android:layout_marginTop="@dimen/material_margin_micro"
                        android:layout_marginEnd="@dimen/material_margin"
                        android:textAppearance="?textAppearanceBodySmall"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintStart_toEndOf="@id/verified_image"
                        app:layout_constraintTop_toBottomOf="@id/verified_text" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logout_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/material_margin"
                android:layout_marginEnd="@dimen/material_margin"
                android:layout_marginBottom="@dimen/material_margin"
                android:backgroundTint="@android:color/white"
                android:padding="12dp"
                android:text="@string/fragment_user_logout"
                android:textColor="?colorSecondary"
                app:cornerRadius="16dp"
                app:strokeColor="?colorSecondary"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </ScrollView>

</ViewAnimator>
